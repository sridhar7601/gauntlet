# ─────────────────────────────────────────────────────────────
# Gauntlet environment — copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Bifrost gateway (OpenAI-compatible). Start it with: npx -y @maximhq/bifrost
BIFROST_BASE_URL=http://127.0.0.1:8080/v1

# Virtual key issued in the Bifrost dashboard (http://localhost:8080).
# Sent as the OpenAI "api_key". Leave as a placeholder for mock-only runs.
BIFROST_VIRTUAL_KEY=sk-bf-REPLACE_ME

# Model the benchmarked agents request (Bifrost resolves provider/model).
# Examples: openai/gpt-4o-mini  |  anthropic/claude-3-5-sonnet  |  azure/<deployment>
GAUNTLET_MODEL=openai/gpt-4o-mini

# ── Upstream provider key(s) — configured INSIDE Bifrost, not read by our app.
# Add these in the Bifrost dashboard or config/bifrost.config.json. Listed here
# so judges know what to supply. One is enough to run live.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Tavily (web tools inside the agents). Free key: https://app.tavily.com
TAVILY_API_KEY=tvly-REPLACE_ME
